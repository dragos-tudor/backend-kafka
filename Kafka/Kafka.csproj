<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Directory.Testing.props" />

  <PropertyGroup>
    <Description>Convenient functions for Confluent Kafka.</Description>

    <!-- Hook our custom target for referenced outputs -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Confluent.Kafka" />
    <ProjectReference Include="../Kafka.Clients/Kafka.Clients.csproj" PrivateAssets="All"/>
    <ProjectReference Include="../Kafka.Messages/Kafka.Messages.csproj" PrivateAssets="All"/>
  </ItemGroup>

  <Target Name="IncludeReferencedProjectInPackage">
    <ItemGroup>
      <!-- Include both DLL and PDB in the package output -->
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Messages.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Messages.pdb" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Clients.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Clients.pdb" />
    </ItemGroup>
  </Target>

</Project>
