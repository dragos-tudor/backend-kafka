<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Directory.Packing.props" />

  <PropertyGroup>
    <Description>Transactional Inbox/Outbox pattern implementation, convenient functions for Confluent Kafka. [metaproject]</Description>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
  	<None Include="../README.md" Pack="true" PackagePath="\"/>
    <None Include="../LICENSE" Pack="true" PackagePath="\"/>

    <ProjectReference Include="../Kafka.Resiliency/Kafka.Resiliency.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

    <None Include="PublicAPI.Shipped.txt" Pack="true" PackagePath="apidocs\" />
  </ItemGroup>

  <Target Name="IncludeReferencedProjectInPackage">
    <ItemGroup>
      <!-- Include both DLL and PDB in the package output -->
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Clients.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Clients.pdb" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.StateMachines.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.StateMachines.pdb" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Messages.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Messages.pdb" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Resiliency.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Resiliency.pdb" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Utils.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Kafka.Utils.pdb" />
    </ItemGroup>
  </Target>

</Project>
